<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aizen.controller.PreviewController">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20"/>
            </padding>
            <Label fx:id="titleLabel" text="Preview" styleClass="page-title"/>
            <ProgressIndicator fx:id="progress" prefWidth="24" prefHeight="24" visible="false"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back" onAction="#onBack" styleClass="secondary-button"/>
            <Button text="Edit" onAction="#onEdit" styleClass="secondary-button"/>
            <Button text="Export PDF" onAction="#onExportPdf" styleClass="primary-button"/>
        </HBox>
    </top>
    <center>
        <TextArea fx:id="previewArea" editable="false" wrapText="true" styleClass="preview-text">
            <BorderPane.margin>
                <Insets top="16" right="20" bottom="10" left="20"/>
            </BorderPane.margin>
        </TextArea>
    </center>
    <bottom>
        <HBox styleClass="status-bar">
            <padding>
                <Insets top="8" right="20" bottom="8" left="20"/>
            </padding>
            <Label fx:id="statusLabel" text=" "/>
        </HBox>
    </bottom>
</BorderPane>
