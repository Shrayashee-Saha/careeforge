<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aizen.controller.DashboardController" spacing="22">
    <padding>
        <Insets top="30" right="34" bottom="30" left="34"/>
    </padding>

    <VBox styleClass="welcome-banner" spacing="6">
        <padding>
            <Insets top="26" right="28" bottom="26" left="28"/>
        </padding>
        <Label fx:id="welcomeLabel" styleClass="banner-title"/>
        <Label text="Build polished resumes, generate cover letters and export them in seconds."
               styleClass="banner-sub"/>
    </VBox>

    <HBox spacing="18">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label fx:id="countLabel" text="-" styleClass="stat-value"/>
            <Label text="Saved resumes" styleClass="stat-label"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label fx:id="roleLabel" text="-" styleClass="stat-value"/>
            <Label text="Latest profile type" styleClass="stat-label"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label fx:id="aiLabel" text="-" styleClass="stat-value"/>
            <Label text="AI generation mode" styleClass="stat-label"/>
        </VBox>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Quick actions" styleClass="section-heading"/>
        <ProgressIndicator fx:id="progress" prefWidth="22" prefHeight="22" visible="false"/>
    </HBox>
    <HBox spacing="14">
        <Button text="Create new resume" onAction="#onNewResume" styleClass="primary-button"/>
        <Button text="Write a cover letter" onAction="#onCoverLetter" styleClass="secondary-button"/>
        <Button text="View saved resumes" onAction="#onSaved" styleClass="secondary-button"/>
    </HBox>
    <Label fx:id="statusLabel" styleClass="muted" wrapText="true"/>
</VBox>
