<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.aizen.controller.PreviewController" styleClass="view-container">
    <padding><Insets bottom="16" left="16" right="16" top="16"/></padding>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <TextArea fx:id="previewArea" editable="false" styleClass="preview-text" wrapText="true"/>
    </ScrollPane>
    <Button onAction="#handleClose" text="Close"/>
</VBox>
